{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AtomicComponentMeta",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "viewBox",
    "dimensions",
    "immutable_inputs",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Mã định danh duy nhất (slug), ví dụ: head_34_confident"
    },
    "name": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["head", "torso", "limb", "prop", "fx", "scene_rig"]
    },
    "viewBox": {
      "type": "string",
      "pattern": "^0 0 \\d+ \\d+$",
      "description": "Khuôn toạ độ chuẩn, ví dụ: 0 0 300 300"
    },
    "dimensions": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "pivots": {
      "type": "object",
      "description": "Toạ độ tâm xoay chuẩn hoá cho chuyển động Remotion",
      "additionalProperties": {
        "type": "object",
        "required": ["x", "y"],
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        }
      }
    },
    "sockets": {
      "type": "object",
      "description": "Magnetic connection points for Lego assembly (e.g., neck, hip, shoulder sockets)",
      "additionalProperties": {
        "type": "object",
        "required": ["x", "y"],
        "properties": {
          "x": { "type": "number", "description": "X coordinate in component's local viewBox" },
          "y": { "type": "number", "description": "Y coordinate in component's local viewBox" }
        }
      }
    },
    "immutable_inputs": {
      "type": "object",
      "description": "Các thuộc tính đầu vào bất biến mà linh kiện cho phép can thiệp",
      "properties": {
        "props_allowed": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ví dụ: ['style', 'className', 'expression', 'rotation']"
        },
        "color_tokens_used": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Danh sách biến màu phụ thuộc: ['#2563EB', '#FFE3D1']"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Danh sách các linh kiện con hoặc model sheet tham chiếu"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "version": { "type": "string", "default": "1.0.0" }
  }
}
