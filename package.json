{
  "name": "auto-video-engine",
  "version": "1.0.0",
  "description": "Scalable, multi-tenant programmatic video engine powered by Remotion, React, and Zod",
  "scripts": {
    "dev": "vite",
    "build:showcase": "vite build",
    "preview": "vite preview",
    "start": "remotion preview src/index.ts",
    "build": "remotion bundle src/index.ts",
    "render": "remotion render src/index.ts MasterComposition out/video.mp4",
    "render:still": "remotion still src/index.ts MasterComposition out/still.png",
    "type-check": "tsc --noEmit",
    "validate:configs": "tsx scripts/validate-configs.ts",
    "generate:manifest": "tsx scripts/generate-manifest.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "@remotion/player": "^4.0.539",
    "@remotion/transitions": "4.0.240",
    "@types/three": "^0.187.0",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.240",
    "three": "^0.187.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.240",
    "@resvg/resvg-js-cli": "^2.6.2-beta.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  }
}
